# Discord bot token (Developer Portal → your app → Bot → Reset Token)
DISCORD_TOKEN=

# Transcription API key (https://console.groq.com/keys). For OpenAI use OPENAI_API_KEY instead.
GROQ_API_KEY=

# Claude API key for summaries (https://platform.claude.com/settings/keys)
ANTHROPIC_API_KEY=

# Where sessions (audio, logs, transcripts) are written
DATA_DIR=./data

# Settings file (ignore list, speaker names, transcription options); see config.example.yaml
CONFIG_PATH=./config.yaml

# Optional: path to ffmpeg if it's not on PATH
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg

# Web app (npm run app). Required: the app controls a recording bot.
APP_PASSWORD=
# APP_PORT=4400
# Other sites allowed to call the API, e.g. a Vercel-hosted UI later (comma-separated origins)
# APP_CORS_ORIGINS=https://your-app.vercel.app
