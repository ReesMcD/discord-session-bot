# Discord bot token (Developer Portal → your app → Bot → Reset Token)
DISCORD_TOKEN=

# Comma-separated user IDs never to record (e.g. your music bot)
IGNORE_USER_IDS=

# Skip every bot account, not just the ones listed above
IGNORE_BOTS=true

# Where sessions (audio, logs, transcripts) are written
DATA_DIR=./data

# Optional: path to ffmpeg if it's not on PATH (needed for spike:mix and transcription)
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
