{
  "name": "discord-session-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted Discord bot that records voice calls per speaker and produces timestamped transcripts.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "spike:receive": "tsx src/spike/receive.ts",
    "spike:mix": "tsx src/spike/mix.ts",
    "transcribe": "tsx src/cli/transcribe.ts",
    "merge": "tsx src/cli/merge.ts",
    "check:deps": "tsx scripts/check-deps.ts",
    "import:craig": "tsx src/cli/importCraig.ts",
    "summarize": "tsx src/cli/summarize.ts",
    "doctor": "tsx src/cli/doctor.ts",
    "disambiguate": "tsx src/cli/disambiguate.ts",
    "app": "tsx src/app/server.ts",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "web:typecheck": "tsc -p web/tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@discordjs/voice": "0.19.2",
    "@hono/node-server": "^2.1.1",
    "discord.js": "^14.27.0",
    "hono": "^4.13.9",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
